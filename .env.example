# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional 64-char hex secret for signing Owner session cookies.
# If omitted, server.ts auto-generates and persists a secure secret in data/.session_secret.
SESSION_SECRET=""

# Optional External Supabase PostgreSQL + Auth (see supabase/SETUP.md)
# NEVER expose SUPABASE_SERVICE_ROLE_KEY in client-side code or VITE_* variables.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
